{
  "name": "Marketing ROI - Clean Light",
  "dataColors": ["#2A78D6", "#EB6834", "#1BAF7A", "#EDA100", "#E87BA4", "#008300", "#4A3AA7", "#E34948"],
  "background": "#FFFFFF",
  "foreground": "#1F2A37",
  "tableAccent": "#2A78D6",
  "good": "#1B7F4C",
  "neutral": "#C98500",
  "bad": "#C0392B",
  "maximum": "#1A4F8F",
  "center": "#9DB9E3",
  "minimum": "#EEF3FA",
  "textClasses": {
    "callout":  { "fontSize": 24, "fontFace": "Segoe UI Semibold", "color": "#0B1B2B" },
    "title":    { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2A37" },
    "header":   { "fontSize": 11, "fontFace": "Segoe UI Semibold", "color": "#1F2A37" },
    "label":    { "fontSize": 10, "fontFace": "Segoe UI", "color": "#52514E" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E7EE" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "visualHeader": [{ "show": true }],
        "title": [{ "show": true, "fontSize": 12, "fontColor": { "solid": { "color": "#1F2A37" } } }],
        "padding": [{ "top": 8, "bottom": 8, "left": 10, "right": 10 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6FA" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F6FA" } } }]
      }
    },
    "card": {
      "*": {
        "labels": [{ "fontSize": 22, "color": { "solid": { "color": "#0B1B2B" } } }],
        "categoryLabels": [{ "fontSize": 10, "color": { "solid": { "color": "#52514E" } } }]
      }
    },
    "slicer": {
      "*": {
        "header": [{ "fontSize": 10, "fontColor": { "solid": { "color": "#52514E" } } }],
        "items": [{ "fontSize": 10 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontSize": 10, "backColor": { "solid": { "color": "#0F2A4A" } }, "fontColor": { "solid": { "color": "#FFFFFF" } } }],
        "values": [{ "fontSize": 10, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F7F9FC" } } }],
        "total": [{ "fontSize": 10, "backColor": { "solid": { "color": "#E8EEF7" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2 }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#EEF1F5" } } }]
      }
    }
  }
}
